---
import ActionLink from "./ActionLink.astro";

interface Link {
  label: string;
  href: string;
  icon: "email" | "linkedin" | "github" | "booking" | "pdf";
  newTab?: boolean;
}

interface Props {
  name: string;
  subtitle?: string;
  links?: Link[];
}

const { name, subtitle, links = [] } = Astro.props;

const homeHref = new URL("/resume/", import.meta.env.SITE).href;

const strokeIcon = (inner: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true" focusable="false">${inner}</svg>`;

const fillIcon = (inner: string) =>
  `<svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true" focusable="false">${inner}</svg>`;

const ICONS: Record<Link["icon"], string> = {
  email: strokeIcon(
    '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 6 10 7 10-7"/>',
  ),
  linkedin: fillIcon(
    '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.114 20.452H3.556V9h3.558v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>',
  ),
  github: fillIcon(
    '<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.333-1.755-1.333-1.755-1.089-.744.083-.729.083-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.807 1.305 3.492.997.108-.775.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3.003-.404c1.02.005 2.047.138 3.003.404 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>',
  ),
  booking: strokeIcon(
    '<rect x="3" y="4" width="18" height="17" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="9" x2="21" y2="9"/>',
  ),
  pdf: strokeIcon(
    '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>',
  ),
};
---

<header class="text-center">
  <h1 class="font-['Fraunces'] text-3xl font-bold text-navy-900">
    <a href={homeHref}>{name}</a>
  </h1>
  {subtitle && <p class="mt-1 text-sm text-ink-500">{subtitle}</p>}
  <div class="mt-3 flex flex-wrap justify-center gap-x-4 gap-y-2">
    {links.map((link) => (
      <ActionLink href={link.href} newTab={link.newTab}>
        <Fragment set:html={ICONS[link.icon]} />
        <span class="text-xs">{link.label}</span>
      </ActionLink>
    ))}
  </div>
  <hr class="mx-auto mt-4 w-16 border-t-2 border-wood-500" />
</header>
