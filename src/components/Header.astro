---
import ActionLink from "./ActionLink.astro";
import { ICONS } from "./icons";

interface Link {
  label: string;
  href: string;
  icon: keyof typeof ICONS;
  newTab?: boolean;
}

interface Props {
  name: string;
  subtitle?: string;
  links?: Link[];
}

const { name, subtitle, links = [] } = Astro.props;

const homeHref = new URL("/", import.meta.env.SITE).href;
---

<header class="text-center">
  <h1 class="font-['Fraunces'] text-3xl font-bold text-navy-900">
    <a href={homeHref}>{name}</a>
  </h1>
  {subtitle && <p class="mt-1 text-sm text-ink-500">{subtitle}</p>}
  <div class="mt-3 flex flex-wrap justify-center gap-x-4 gap-y-2">
    {links.map((link) => (
      <ActionLink href={link.href} newTab={link.newTab}>
        <Fragment set:html={ICONS[link.icon]} />
        <span class="text-xs">{link.label}</span>
      </ActionLink>
    ))}
  </div>
  <hr class="mx-auto mt-4 w-16 border-t-2 border-wood-500" />
</header>
