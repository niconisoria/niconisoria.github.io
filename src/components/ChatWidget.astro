---
// Chat with the resume agent. The landing shows starter prompts and an
// "Ask about Nicolas…" button; Deep Chat lives permanently in a native
// full-screen <dialog> (never moved, so the conversation survives closing).
// showModal() gives Esc, focus handling, an inert page and modal semantics.
import { STARTER_PROMPTS } from "../lib/chat";

const focusRing =
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-700";
---

<div data-chat class="w-full">
  <div class="mb-3 flex flex-wrap justify-center gap-2">
    {STARTER_PROMPTS.map((prompt) => (
      <button
        type="button"
        data-starter
        class={`cursor-pointer rounded-full border border-navy-200 px-3.5 py-1.5 text-sm text-navy-900 transition-colors hover:border-wood-500 hover:bg-wood-500/10 ${focusRing}`}
      >
        {prompt}
      </button>
    ))}
  </div>
  <button
    type="button"
    data-chat-open
    class={`flex min-h-12 w-full cursor-text items-center justify-between gap-3 rounded-full border border-navy-200 bg-paper px-5 text-left text-[0.9375rem] text-ink-500 transition-colors hover:border-navy-700 ${focusRing}`}
  >
    Ask about Nicolas…
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7z"></path>
    </svg>
  </button>

  <dialog data-chat-dialog aria-labelledby="chat-title" class="text-left">
    <div class="mb-4 flex items-center justify-between gap-4">
      <h2
        id="chat-title"
        class="m-0 font-['Fraunces'] text-xl font-bold text-navy-900"
      >
        Explore Nicolas's career
      </h2>
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-chat-new
          class={`cursor-pointer rounded-full border border-navy-200 bg-paper px-3.5 py-1.5 text-sm whitespace-nowrap text-navy-700 transition-colors hover:border-wood-500 ${focusRing}`}
        >
          New chat
        </button>
        <form method="dialog">
          <button
            aria-label="Close chat"
            class={`cursor-pointer rounded-full border border-navy-200 bg-paper p-2 text-navy-700 transition-colors hover:border-wood-500 ${focusRing}`}
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>
    <deep-chat data-chat-box></deep-chat>
    <p data-chat-failed hidden class="my-auto text-center text-ink-500">
      The chat couldn't load. Please refresh the page and try again.
    </p>
    <p class="mt-2 text-center text-2xs text-ink-500">
      Messages are processed by AI. Emails you share are used only so Nicolas
      can reply.
      <!-- new tab: navigating away would drop the in-memory conversation -->
      <a
        href="/insights/"
        target="_blank"
        rel="noopener"
        class={`underline underline-offset-2 hover:text-navy-700 ${focusRing}`}
      >
        See how it's used
      </a>
    </p>
  </dialog>
</div>

<style>
  /* Full-screen dialog, chat column centred and capped at 48rem. Theme colors are
     CSS variables, which also inherit into Deep Chat's shadow DOM. */
  dialog {
    margin: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    border: 0;
    padding: 1rem max(1rem, calc((100vw - 48rem) / 2));
    background: var(--color-paper);
    color: var(--color-ink-900);
  }
  dialog[open] {
    display: flex;
    flex-direction: column;
  }
  deep-chat {
    display: block;
    flex: 1;
    min-height: 0;
  }
  :global(html:has(dialog[data-chat-dialog][open])) {
    overflow: hidden;
  }
  @media (prefers-reduced-motion: no-preference) {
    dialog[open] {
      animation: chat-open 0.2s ease-out;
    }
    @keyframes chat-open {
      from {
        opacity: 0;
      }
    }
  }
</style>

<script>
  import {
    CHAT_URL,
    chatRequest,
    chatResponse,
    newChat,
    sendFeedback,
    takeExtrasHtml,
  } from "../lib/chat";

  const wrapper = document.querySelector<HTMLElement>("[data-chat]");
  const dialog =
    wrapper?.querySelector<HTMLDialogElement>("[data-chat-dialog]");
  // deep-chat has no published element typings for this property-based setup
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  const chat = dialog?.querySelector<any>("[data-chat-box]");

  // Deep Chat is ~115KB gzipped: load it once the page is idle, not on first paint.
  // Properties are set only after the element is defined, so its setters see them.
  const idle = () =>
    new Promise((resolve) =>
      "requestIdleCallback" in window
        ? requestIdleCallback(resolve, { timeout: 2000 })
        : setTimeout(resolve, 200),
    );
  const ready = idle()
    .then(() => import("deep-chat"))
    .then(setup);
  // e.g. the chunk failed to download: say so instead of an empty dialog
  ready.catch(() => {
    chat?.remove();
    dialog
      ?.querySelector<HTMLElement>("[data-chat-failed]")
      ?.removeAttribute("hidden");
  });

  function open() {
    if (!dialog?.open) dialog?.showModal();
  }

  wrapper?.querySelector("[data-chat-open]")?.addEventListener("click", () => {
    open();
    ready.then(() => chat.focusInput());
  });
  for (const button of wrapper?.querySelectorAll<HTMLButtonElement>(
    "[data-starter]",
  ) ?? []) {
    button.addEventListener("click", () => {
      open();
      ready.then(() =>
        chat.submitUserMessage({ text: button.textContent?.trim() }),
      );
    });
  }

  dialog?.querySelector("[data-chat-new]")?.addEventListener("click", () => {
    newChat();
    ready.then(() => {
      chat.clearMessages();
      chat.focusInput();
    });
  });

  const errorTimers = new WeakMap<Element, number>();

  // The pressed state only changes once the server saved the vote. One request per
  // answer at a time, so replies can't land out of order.
  async function vote(event: Event) {
    const button = (event.target as Element).closest<HTMLElement>(
      "[data-rating]",
    );
    const box = button?.closest<HTMLElement>("[data-message-id]");
    if (!button || !box?.dataset.messageId) return;
    if (button.ariaPressed === "true" || box.ariaBusy === "true") return;
    box.ariaBusy = "true";
    const rating = Number(button.dataset.rating) as 1 | -1;
    const result = await sendFeedback(box.dataset.messageId, rating);
    box.ariaBusy = null;
    if ("error" in result) {
      const status = box.querySelector("[role=status]");
      if (!status) return;
      status.textContent = result.error;
      clearTimeout(errorTimers.get(status));
      errorTimers.set(
        status,
        window.setTimeout(() => (status.textContent = ""), 4000),
      );
      return;
    }
    for (const thumb of box.querySelectorAll("[data-rating]"))
      thumb.setAttribute("aria-pressed", String(thumb === button));
  }

  function setup() {
    if (!chat) return;
    chat.connect = { url: CHAT_URL, method: "POST", stream: true };
    chat.requestInterceptor = chatRequest;
    chat.responseInterceptor = chatResponse;
    // A finished AI reply: put its sources and action cards in a bubble right under it
    chat.addEventListener("message", (event: CustomEvent) => {
      const { message, isHistory } = event.detail;
      if (isHistory || message.role !== "ai" || message.html) return;
      const html = takeExtrasHtml();
      if (html) chat.addMessage({ role: "ai", html });
    });
    // 👍/👎 live in Deep Chat's shadow DOM: one delegated listener for all answers
    chat.shadowRoot.addEventListener("click", vote);
    chat.errorMessages = { displayServiceErrorMessages: true };
    // CSS inside the shadow DOM: themed thin scrollbar (default track is light gray
    // on dark), and #container filling the host so the input sits at the bottom of
    // the full-screen chat (it otherwise sizes to its content)
    chat.auxiliaryStyle = `
      * { scrollbar-width: thin; scrollbar-color: var(--color-navy-200) transparent; }
      #container { height: 100%; }
      .chat-cards { display: flex; flex-wrap: wrap; gap: 8px; }
      .chat-card {
        border: 1px solid var(--color-navy-200); border-radius: 9999px;
        padding: 6px 14px; color: var(--color-navy-700); text-decoration: none;
        font-size: 14px; background: var(--color-paper);
      }
      .chat-card:hover { border-color: var(--color-wood-500); }
      .chat-card:focus-visible { outline: 2px solid var(--color-navy-700); outline-offset: 2px; }
      .chat-sources { margin-top: 8px; font-size: 13px; color: var(--color-ink-500); }
      .chat-sources p { margin: 0 0 2px; font-weight: 600; }
      .chat-sources ul { margin: 0; padding-left: 18px; }
      .chat-chip {
        border: 1px solid var(--color-navy-200); border-radius: 9999px;
        padding: 6px 14px; font-size: 14px; color: var(--color-ink-900);
        background: var(--color-navy-100);
      }
      .chat-feedback { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 8px; }
      .chat-feedback button {
        cursor: pointer; border: 1px solid var(--color-navy-200); border-radius: 9999px;
        padding: 3px 10px; font-size: 14px; background: var(--color-paper);
      }
      .chat-feedback button:hover { border-color: var(--color-wood-500); }
      .chat-feedback button:focus-visible { outline: 2px solid var(--color-navy-700); outline-offset: 2px; }
      .chat-feedback button[aria-pressed="true"] {
        border-color: var(--color-navy-700); background: var(--color-navy-100);
        box-shadow: 0 0 0 1px var(--color-navy-700);
      }
      .chat-feedback [role="status"] { font-size: 13px; color: var(--color-ink-500); }
    `;
    chat.chatStyle = {
      width: "100%",
      height: "100%",
      border: "none",
      backgroundColor: "transparent",
      fontFamily: "inherit",
      fontSize: "15px",
    };
    chat.textInput = {
      placeholder: {
        text: "Ask about Nicolas…",
        style: { color: "var(--color-ink-500)" },
      },
      styles: {
        container: {
          backgroundColor: "var(--color-paper)",
          border: "1px solid var(--color-navy-200)",
          borderRadius: "21px", // half the single-line height: pill on one line, rounded box when wrapped
          boxShadow: "none",
          width: "100%",
        },
        // 16px: iOS Safari zooms the page on focus of any smaller input
        text: {
          color: "var(--color-ink-900)",
          fontSize: "16px",
          padding: "11px 48px 11px 18px",
        },
        focus: { border: "1px solid var(--color-navy-700)" },
      },
    };
    chat.messageStyles = {
      default: {
        shared: {
          bubble: { fontSize: "15px", lineHeight: "1.55", maxWidth: "85%" },
        },
        user: {
          bubble: {
            backgroundColor: "var(--color-navy-900)",
            color: "var(--color-paper)",
          },
        },
        ai: {
          bubble: {
            backgroundColor: "var(--color-navy-100)",
            color: "var(--color-ink-900)",
          },
        },
      },
      // sources + cards bubble: no fill, so it reads as part of the answer above
      html: {
        ai: {
          bubble: {
            backgroundColor: "transparent",
            padding: "0 0 0 2px",
            marginTop: "6px",
            maxWidth: "85%",
          },
        },
      },
      error: {
        bubble: {
          backgroundColor: "transparent",
          border: "1px solid var(--color-wood-500)",
          color: "var(--color-ink-900)",
        },
      },
    };
    // Deep Chat anchors the button 5px from the input's bottom-right corner: lift it
    // 5px to centre it vertically, and move it 10px in, clear of the pill's rounded end
    const lift = {
      container: { default: { marginBottom: "8px", marginRight: "10px" } },
    };
    chat.submitButtonStyles = {
      position: "inside-end",
      submit: lift,
      loading: lift,
      stop: lift,
    };
  }
</script>
