---
const sunIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true" focusable="false" data-icon="sun"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>`;

const moonIcon = `<svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true" focusable="false" data-icon="moon"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>`;
---

<button
  type="button"
  id="theme-toggle"
  class="fixed top-4 right-4 cursor-pointer rounded-full border border-navy-200 bg-paper p-2 text-navy-700 shadow-sm"
  aria-label="Switch to dark theme"
>
  <Fragment set:html={sunIcon} />
  <Fragment set:html={moonIcon} />
</button>

<style>
  #theme-toggle :global([data-icon="moon"]) {
    display: none;
  }
  :global(:root[data-theme="dark"]) #theme-toggle :global([data-icon="sun"]) {
    display: none;
  }
  :global(:root[data-theme="dark"]) #theme-toggle :global([data-icon="moon"]) {
    display: block;
  }
  @media print {
    #theme-toggle {
      display: none;
    }
  }
</style>

<script>
  const button = document.getElementById("theme-toggle") as HTMLButtonElement;

  function currentTheme(): "light" | "dark" {
    return document.documentElement.dataset.theme === "dark" ? "dark" : "light";
  }

  function applyLabel() {
    const theme = currentTheme();
    button.setAttribute(
      "aria-label",
      theme === "dark" ? "Switch to light theme" : "Switch to dark theme",
    );
  }

  function setTheme(theme: "light" | "dark") {
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem("theme", theme);
    } catch {
      // storage blocked (e.g. private mode) — theme still applies for this page view
    }
    applyLabel();
  }

  // theme already applied by Layout's head script; this just syncs the button label
  applyLabel();

  button.addEventListener("click", () => {
    setTheme(currentTheme() === "dark" ? "light" : "dark");
  });
</script>
