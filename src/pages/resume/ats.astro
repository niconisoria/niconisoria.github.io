---
// Private, ATS-optimized version of the resume — for filling out job
// application forms (e.g. Workday). Not linked from the site nav, reachable
// by direct URL only. Same content/look as the public page; only the
// Experience job-header order differs (see Experience.astro's `atsSafe`).
import ResumeBody from "../../components/ResumeBody.astro";
import Layout from "../../layouts/Layout.astro";

const pdfHrefEn = new URL(
  "/resume/nicolas-nisoria-ats.pdf",
  import.meta.env.SITE,
).href;
const pdfHrefPl = new URL(
  "/resume/nicolas-nisoria-ats-pl.pdf",
  import.meta.env.SITE,
).href;
---

<Layout
  title="Nicolas Nisoria — ATS resume"
  description="Private ATS-optimized resume."
>
  <ResumeBody pdfHref={pdfHrefEn} lang="en" atsSafe />
  <ResumeBody pdfHref={pdfHrefPl} lang="pl" atsSafe />
</Layout>
