---
import ChatWidget from "../components/ChatWidget.astro";
import GrainHero from "../components/GrainHero.astro";
import { ICONS } from "../components/icons";
import { resumeData } from "../data/resume.en";
import LandingLayout from "../layouts/LandingLayout.astro";

const { name, subtitle, headerLinks } = resumeData;
// header labels are handles ("niconisoria"); the landing names the destination
const LABELS = {
  linkedin: "LinkedIn",
  github: "GitHub",
  booking: "Book a call",
};
const links = headerLinks.flatMap((link) =>
  link.icon === "email"
    ? []
    : [{ href: link.href, label: LABELS[link.icon], icon: ICONS[link.icon] }],
);
const pill =
  "inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-navy-200 bg-paper px-5 text-[0.9375rem] font-semibold text-navy-900 transition-colors hover:border-wood-500 hover:bg-wood-500/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-700";
---

<LandingLayout>
  <GrainHero>
    <p class="mb-6 text-xs font-semibold tracking-[0.2em] text-navy-900 uppercase">
      {subtitle}
    </p>
    <h1 class="m-0 font-['Fraunces'] text-[clamp(3rem,9vw,7rem)] leading-[0.95] font-bold tracking-tight text-navy-900">
      {name.split(" ").map((word, i) => (
        <>
          {i > 0 && " "}
          <span data-word class="inline-block">
            {word}
          </span>
        </>
      ))}
    </h1>
  </GrainHero>

  <main class="flex flex-col items-center px-4 pt-6 pb-10 text-center">
    <p class="m-0 max-w-136 text-lg leading-relaxed text-ink-500">
      From whiteboard to production, and everything in between
      <span aria-hidden="true"> ⚡ </span>
    </p>

    <nav
      aria-label="Links"
      class="mt-11 grid w-full max-w-sm grid-cols-2 gap-3 sm:flex sm:w-auto sm:max-w-none sm:flex-wrap sm:justify-center"
    >
      <a
        href="/resume/"
        class="group inline-flex min-h-12 items-center justify-center gap-2.5 rounded-full bg-navy-900 px-6 text-[0.9375rem] font-semibold text-paper transition-shadow hover:ring-2 hover:ring-wood-500 hover:ring-offset-2 hover:ring-offset-paper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-700"
      >
        <Fragment set:html={ICONS.pdf} />
        View CV
        <svg
          class="transition-transform motion-safe:group-hover:translate-x-1"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
      {links.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class={pill}
        >
          <Fragment set:html={link.icon} />
          {link.label}
        </a>
      ))}
    </nav>

    <section id="chat" aria-label="Chat" class="mt-8 w-full max-w-xl">
      <ChatWidget />
    </section>
  </main>
</LandingLayout>
