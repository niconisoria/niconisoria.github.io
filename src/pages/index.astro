---
import Header from "../components/Header.astro";
import { resumeData } from "../data/resume.en";
import Layout from "../layouts/Layout.astro";

const { name, subtitle, headerLinks } = resumeData;
const links = [
  { label: "CV", href: "/resume/", icon: "pdf" as const },
  ...headerLinks.filter((link) => link.icon !== "email"),
];
---

<Layout
  description="Nicolas Nisoria, Senior Software Engineer."
  langToggle={false}
>
  <Header name={name} subtitle={subtitle} links={links} />
  {/* ponytail: empty until chat widget (resume-agent S04/S09/S12) lands */}
  <section id="chat"></section>
</Layout>
