---
// Landing-only shell: phone-width viewport and full-bleed body. The CV keeps
// Layout.astro (fixed 1024px viewport, print-tuned).
import ThemeScript from "../components/ThemeScript.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Nicolas Nisoria — Senior Software Engineer",
  description = "Nicolas Nisoria, Senior Software Engineer.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:wght@700&display=swap"
      rel="stylesheet"
    />
    <ThemeScript />
    <script is:inline>
      // Hide name words before first paint only when they will be animated in.
      // Safety net: reveal anyway if the module script never runs.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.dataset.reveal = "pending";
        setTimeout(() => {
          if (document.documentElement.dataset.reveal === "pending") {
            document.documentElement.dataset.reveal = "done";
          }
        }, 3000);
      }
    </script>
  </head>
  <body class="min-h-svh bg-paper text-ink-900">
    <slot />
    <ThemeToggle />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
  }
  :global(:root[data-reveal="pending"] [data-word]) {
    opacity: 0;
  }
</style>
