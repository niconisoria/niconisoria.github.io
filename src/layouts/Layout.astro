---
import LangToggle from "../components/LangToggle.astro";
import ThemeScript from "../components/ThemeScript.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Nicolas Nisoria — Senior Software Engineer",
  description = "Resume of Nicolas Nisoria, Senior Software Engineer.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1024" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:wght@700&display=swap"
      rel="stylesheet"
    />
    <ThemeScript />
    <script is:inline>
      let storedLang = null;
      try {
        storedLang = localStorage.getItem("lang");
      } catch {
        // storage blocked (e.g. private mode) — fall through to default
      }
      const queryLang = new URLSearchParams(window.location.search).get("lang");
      if (queryLang === "pl" || queryLang === "en") {
        document.documentElement.dataset.lang = queryLang;
      } else {
        document.documentElement.dataset.lang =
          storedLang === "pl" ? "pl" : "en";
      }
    </script>
  </head>
  <body class="min-h-screen bg-paper p-10">
    <div class="mx-auto max-w-4xl">
      <slot />
    </div>
    <a
      href="/"
      aria-label="Back to home"
      class="fixed top-4 left-4 rounded-full border border-navy-200 bg-paper p-2 text-navy-700 shadow-sm print:hidden"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M19 12H5M11 18l-6-6 6-6"></path>
      </svg>
    </a>
    <ThemeToggle />
    <LangToggle />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
  }
</style>
